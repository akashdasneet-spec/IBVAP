# ==============================================================================
# Intelligent Border Video Analytics Platform (IBVAP) — Environment Configuration
# ==============================================================================
# NOTICE: This is an example template. DO NOT commit actual production keys or secrets.
# Copy this file to '.env' for local configuration.
# ==============================================================================

# --- Operational Environment ---
IBVAP_ENV=development                       # 'production', 'staging', or 'development'
IBVAP_ALLOW_EPHEMERAL_KEY=false             # STRICTLY for local testing; must be 'false' in production

# --- Central C2 Database Configuration (PostgreSQL 16 with pgvector) ---
POSTGRES_DB=ibvap_tactical_db
POSTGRES_USER=ibvap_admin
POSTGRES_PASSWORD=CHANGEME_SECURE_PASSWORD_HERE
DATABASE_URL=postgresql+asyncpg://ibvap_admin:CHANGEME_SECURE_PASSWORD_HERE@postgres:5432/ibvap_tactical_db

# --- Central Gateway & Security ---
GATEWAY_PORT=8000
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://c2.ibvap.defense.mil
EDGE_API_TOKEN=CHANGEME_SECURE_EDGE_SHARED_TOKEN_HERE

# --- CERT-In Compliance & Cryptographic Audit Signing (Ed25519) ---
# Provide either a secure filesystem path (mode 0600) or a 64-character hex-encoded private key
CERTIN_SIGNING_KEY_PATH=/etc/ibvap/keys/certin_audit_key.pem
# CERTIN_SIGNING_KEY_HEX=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
CERTIN_AUDIT_LOG_PATH=audit_ledger_certin.jsonl

# --- Evidence Vault & AES-256-GCM Key (Edge Node) ---
# Must be exactly 32 bytes (64 hex characters or 32 raw bytes)
EVIDENCE_MASTER_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
EVIDENCE_CACHE_DIR=/var/lib/ibvap/evidence_cache
EVIDENCE_CACHE_MAX_BYTES=10737418240        # 10 GB limit for local cached clips
EVIDENCE_MIN_FREE_BYTES=1073741824          # 1 GB minimum free disk threshold

# --- IPFS Evidence Storage ---
IPFS_PATH=/data/ipfs
IPFS_API_URL=http://ipfs:5001/api/v0

# --- Tactical C4ISR & ATAK/WinTAK Mesh ---
TAK_SERVER_URL=udp://239.2.3.1:6969

# --- Edge Node Deployment Configuration ---
SENSOR_ID=a1b2c3d4-e5f6-7a8b-9c0d-1e2f3a4b5c6d
BOP_SECTOR_ID=BOP-SECTOR-ALPHA-01
RTSP_URL=videotestsrc

# --- Tactical Web Situation Room (Next.js Build & Runtime) ---
NEXT_PUBLIC_GATEWAY_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000/ws/v1/c2
