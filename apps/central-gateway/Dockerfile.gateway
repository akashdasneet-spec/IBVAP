# Production Dockerfile for IBVAP Central Gateway
FROM python:3.11-slim as base

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    DEBIAN_FRONTEND=noninteractive

# Install curl and system libraries
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    libpq-dev \
    gcc \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /workspace

# Install uv
RUN curl -LsSf https://astral.sh/uv/install.sh | sh
ENV PATH="/root/.cargo/bin:${PATH}"

# Copy Core Types and App
COPY packages/core-types /workspace/packages/core-types
COPY apps/central-gateway /workspace/apps/central-gateway

WORKDIR /workspace/packages/core-types
RUN pip install --no-cache-dir -e .

WORKDIR /workspace/apps/central-gateway
RUN pip install --no-cache-dir -e .

EXPOSE 8000

CMD ["sh", "-c", "uvicorn src.main:app --host 0.0.0.0 --port ${PORT:-8000}"]
