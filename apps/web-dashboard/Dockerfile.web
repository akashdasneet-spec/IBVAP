# Production Dockerfile for IBVAP Tactical Web Dashboard
FROM node:20-alpine AS base

WORKDIR /app
RUN corepack enable && corepack prepare pnpm@9.1.0 --activate

COPY pnpm-workspace.yaml package.json turbo.json ./
COPY packages/core-types ./packages/core-types
COPY apps/web-dashboard ./apps/web-dashboard

RUN pnpm install --frozen-lockfile=false

WORKDIR /app/apps/web-dashboard

# Build-time environment arguments for Next.js bundle inlining
ARG NEXT_PUBLIC_GATEWAY_URL=http://localhost:8000
ARG NEXT_PUBLIC_WS_URL=ws://localhost:8000/ws/v1/c2

ENV NEXT_PUBLIC_GATEWAY_URL=${NEXT_PUBLIC_GATEWAY_URL} \
    NEXT_PUBLIC_WS_URL=${NEXT_PUBLIC_WS_URL} \
    NODE_ENV=production

# Validation check: Ensure build args are non-empty
RUN if [ -z "$NEXT_PUBLIC_GATEWAY_URL" ] || [ -z "$NEXT_PUBLIC_WS_URL" ]; then \
      echo "ERROR: Build arguments NEXT_PUBLIC_GATEWAY_URL and NEXT_PUBLIC_WS_URL must not be empty" >&2; \
      exit 1; \
    fi

RUN pnpm build

EXPOSE 3000

CMD ["pnpm", "start"]
