# IBVAP Environment Configuration Template
# Copy this template to .env for local configuration

# Database
POSTGRES_DB=ibvap_tactical_db
POSTGRES_USER=ibvap_admin
POSTGRES_PASSWORD=REPLACE_WITH_SECURE_DATABASE_PASSWORD
DATABASE_URL=postgresql+asyncpg://ibvap_admin:REPLACE_WITH_SECURE_DATABASE_PASSWORD@postgres:5432/ibvap_tactical_db

# Security & Tokens
EDGE_API_TOKEN=REPLACE_WITH_SECURE_RANDOM_TOKEN
EVIDENCE_MASTER_KEY=REPLACE_WITH_64_HEX_CHARACTER_KEY

# Tactical TAK Server / Mesh
TAK_SERVER_URL=udp://239.2.3.1:6969

# IPFS Evidence Node
IPFS_API_URL=http://ipfs:5001/api/v0

# Edge Configuration
SENSOR_ID=a1b2c3d4-e5f6-7a8b-9c0d-1e2f3a4b5c6d
BOP_SECTOR_ID=BOP-SECTOR-ALPHA-01
RTSP_URL=videotestsrc

# Web Dashboard
NEXT_PUBLIC_GATEWAY_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000/ws/v1/c2
